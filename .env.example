# Copy this file to .env and adjust as needed for local development.
# .env is gitignored — never commit real secrets.

# --- Django ---
DEBUG=True
SECRET_KEY=django-insecure-dev-only-change-me
# Ignored while DEBUG=True (backend/config/settings.py allows all hosts in
# that case, since local dev's LAN IP drifts constantly) — only takes effect
# for a real deployment with DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Postgres (PostGIS) ---
POSTGRES_DB=prizm
POSTGRES_USER=prizm
POSTGRES_PASSWORD=prizm
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- MinIO (local S3-compatible object storage) ---
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=prizm-media
AWS_S3_ENDPOINT_URL=http://minio:9000
# Client-reachable endpoint for the same MinIO instance — used only to
# rewrite the host in URLs returned to apps/browsers (they can't resolve
# the Docker-internal "minio" hostname above).
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=False

# --- SMS OTP ---
# No real SMS gateway configured yet. In local dev (DEBUG=True), OTPs are
# logged to the console instead of being sent.

# --- Payments ---
# Mobile money provider TBD — payment gateway is stubbed for now.
