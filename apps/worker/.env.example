# Copy to .env for local dev. iOS simulator can reach the Docker backend at
# localhost; Android emulator needs http://10.0.2.2:8000; a physical device
# needs your machine's LAN IP (e.g. http://192.168.1.20:8000).
EXPO_PUBLIC_API_URL=http://localhost:8000

# SDK 56+ made expo/fetch the default global fetch, which doesn't support
# FormData file uploads yet (upstream bug) — opt back into RN's fetch.
EXPO_PUBLIC_USE_RN_FETCH=1
