# Copy to .env for local dev. The API URL is auto-detected from Metro's own
# dev-server host (see packages/api/src/client.ts) — no need to set this for
# normal dev-client testing (simulator or physical device), since it self-
# corrects whenever your LAN IP changes. Uncomment only to force a different
# backend than the one Metro is running on (e.g. Android emulator's
# http://10.0.2.2:8000, or a remote staging server).
# EXPO_PUBLIC_API_URL=http://localhost:8000

# SDK 56+ made expo/fetch the default global fetch, which doesn't support
# FormData file uploads yet (upstream bug) — opt back into RN's fetch.
EXPO_PUBLIC_USE_RN_FETCH=1
